# ============================================================================
# ARQUIVO DE EXEMPLO DE VARIAVEIS DE AMBIENTE
# ============================================================================
# Este arquivo serve como template para criar o arquivo .env de producao
# 
# INSTRUCOES:
# 1. Copie este arquivo para .env no servidor: cp .env.example .env
# 2. Preencha os valores reais (senhas fortes, credenciais validas)
# 3. NUNCA commite o arquivo .env no repositorio!
# ============================================================================

# CONFIGURACOES DO MYSQL
MYSQL_ROOT_PASSWORD=sua_senha_root_segura_aqui
MYSQL_DATABASE=todolist
MYSQL_USER=todolist_user
MYSQL_PASSWORD=sua_senha_mysql_segura_aqui
MYSQL_PORT=3309

# CONFIGURACOES DO DOCKER
# Nome da imagem Docker (substitua pelo seu username do Docker Hub)
IMAGE_NAME=seu_usuario_dockerhub/todolist-app

# Tag da imagem (sera sobrescrito pelo GitHub Actions durante o deploy)
IMAGE_TAG=latest

# CONFIGURACOES DA APLICACAO SPRING BOOT (Opcional)
SPRING_PROFILES_ACTIVE=prod

# NOTAS DE SEGURANCA
# ATENCAO: Use senhas fortes com pelo menos 16 caracteres
# ATENCAO: Misture letras maiusculas, minusculas, numeros e simbolos
# ATENCAO: Nunca use senhas padrao como "password", "123456", etc.
# ATENCAO: Mantenha este arquivo fora do controle de versao (incluido no .gitignore)

