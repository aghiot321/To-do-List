# ============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ============================================================================
# Este arquivo serve como template para criar o arquivo .env de produção
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env no servidor: cp .env.example .env
# 2. Preencha os valores reais (senhas fortes, credenciais válidas)
# 3. NUNCA commite o arquivo .env no repositório!
# ============================================================================

# ----------------------------------------------------------------------------
# CONFIGURAÇÕES DO MYSQL
# ----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=sua_senha_root_segura_aqui
MYSQL_DATABASE=todolist
MYSQL_USER=todolist_user
MYSQL_PASSWORD=sua_senha_mysql_segura_aqui
MYSQL_PORT=3309

# ----------------------------------------------------------------------------
# CONFIGURAÇÕES DO DOCKER
# ----------------------------------------------------------------------------
# Nome da imagem Docker (substitua pelo seu username do Docker Hub)
IMAGE_NAME=seu_usuario_dockerhub/todolist-app

# Tag da imagem (será sobrescrito pelo GitHub Actions durante o deploy)
IMAGE_TAG=latest

# ----------------------------------------------------------------------------
# CONFIGURAÇÕES DA APLICAÇÃO SPRING BOOT (Opcional)
# ----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# ----------------------------------------------------------------------------
# NOTAS DE SEGURANÇA
# ----------------------------------------------------------------------------
# ⚠️  Use senhas fortes com pelo menos 16 caracteres
# ⚠️  Misture letras maiúsculas, minúsculas, números e símbolos
# ⚠️  Nunca use senhas padrão como "password", "123456", etc.
# ⚠️  Mantenha este arquivo fora do controle de versão (incluído no .gitignore)
